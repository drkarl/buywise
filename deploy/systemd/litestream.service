[Unit]
Description=Litestream replication for BuyWise
# Order after buywise: the app owns the DB file and creates it via
# create_if_missing (crates/core/src/db.rs). Replicating a missing path
# crash-loops, so replication must follow the writer. Wants (not Requires) keeps
# this best-effort: litestream still stops cleanly if the app is down.
After=network.target buywise.service
Wants=buywise.service

[Service]
Type=simple
User=buywise
ExecStart=/usr/local/bin/litestream replicate -config /etc/litestream.yml
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/buywise/buywise.env

[Install]
WantedBy=multi-user.target
